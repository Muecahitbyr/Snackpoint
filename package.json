{
  "name": "snack-point-kaufbeuren",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.jsx && node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "node server/node.js",
    "start:api": "node server/node.js --api-only",
    "release": "node server/cli/seed.js",
    "test": "node scripts/test-chatbot.mjs",
    "test:server": "node --test --test-reporter=spec tests/server/api.test.js",
    "test:all": "npm test && npm run test:server",
    "db:up": "docker compose up -d db",
    "db:migrate": "node server/cli/migrate.js",
    "db:seed": "node server/cli/seed.js",
    "db:backup": "node server/cli/backup.js",
    "db:restore": "node server/cli/restore.js",
    "db:app-role": "node server/cli/app-role.js",
    "admin:create": "node server/cli/admin.js create",
    "admin:reset-password": "node server/cli/admin.js reset-password",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/knewave": "^5.3.0",
    "@fontsource/sedgwick-ave-display": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "gsap": "^3.12.5",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "three": "^0.186.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "railway": "^3.16.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
