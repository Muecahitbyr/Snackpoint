{
  // Cloudflare Workers: website from dist/ (Static Assets) + worker/index.js,
  // which forwards /api/* to the backend on Railway. See ADMIN.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snackpoint",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /admin → admin.html
    "html_handling": "auto-trailing-slash",
    // Everything else comes straight from dist/ without the Worker.
    // Keep the page list in sync with PUBLIC_PAGES (src/seo/structuredData.js).
    "run_worker_first": [
      "/api/*",
      "/", "/produkte", "/impressum", "/datenschutz",
      "/index.html", "/produkte.html", "/impressum.html", "/datenschutz.html",
      "/produkte/", "/impressum/", "/datenschutz/",
      "/robots.txt", "/sitemap.xml",
      "/admin", "/admin/*"
    ]
  },
  "vars": {
    // Public URL of the Railway API service (Settings → Networking).
    "API_ORIGIN": "https://snackpoint-api-production.up.railway.app"
  },
  "observability": { "enabled": true }
}
