# Copy to .env for local development (`cp .env.example .env`).
# .env is git-ignored — never commit real credentials.
# On Railway these are set as service variables instead (see ADMIN.md).

# PostgreSQL connection. Local: the Docker database from `npm run db:up`.
# Railway: ${{Postgres.DATABASE_URL}} (private network).
DATABASE_URL=postgres://snackpoint:snackpoint_local_dev@localhost:5442/snackpoint

# Only for `npm run test:server` — must point to a throwaway database.
TEST_DATABASE_URL=postgres://snackpoint:snackpoint_local_dev@localhost:5442/snackpoint_test

# TLS to the database: true | false | no-verify.
# Default: off for localhost and *.railway.internal, otherwise verified TLS.
# For Railway's public proxy URL (admin commands from your computer): no-verify
# DATABASE_SSL=

# Shared secret with the Cloudflare Worker (long random string, e.g.
# `openssl rand -hex 32`). When set, the API only answers requests that come
# through the Worker. Leave empty for local development.
# PROXY_SECRET=

# Production: NODE_ENV=production (makes session cookies HTTPS-only).
# NODE_ENV=production

# Max upload size in MB (phone photos are scaled down in the browser first).
# MAX_UPLOAD_MB=10

# How long the admin stays logged in: idle timeout (hours) and maximum (days).
# SESSION_IDLE_HOURS=72
# SESSION_MAX_DAYS=30
